{
  "name": "storybook-focus-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "focus-contract": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && npm run build-storybook && node --test tests/*.e2e.mjs",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "focus": "node dist/cli.js",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.65.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.7",
    "storybook": "10.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.11",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "license": "MIT"
}
